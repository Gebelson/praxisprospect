{
  "name": "praxis",
  "version": "1.0.0",
  "description": "Plataforma completa de captação, vendas, criação e gestão de projetos web com inteligência artificial",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"tsx watch server/src/index.ts\" \"vite\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "vite",
    "dev:agent": "tsx watch agent/src/index.ts",
    "build": "vite build && tsc -p server/tsconfig.json",
    "start": "node --experimental-sqlite server/dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^1.16.0",
    "multer": "^1.4.5-lts.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.9",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  }
}
